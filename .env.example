# Copy to .env (git-ignored) and fill in real values for live-API testing.
#
# scripts/smoke_test.py does NOT read this file automatically - source it
# into your shell first:
#   set -a; source .env; set +a
# then pass values as flags, e.g.:
#   uv run python3 scripts/smoke_test.py --token "$REPORTNET_API_KEY" \
#       --dataset-id "$REPORTNET_DATASET_ID" --dataflow-id "$REPORTNET_DATAFLOW_ID"
#
# tools/streamlit_app.py DOES read these directly via os.environ (still
# requires `source .env` first, same as above) - it prefills the sidebar's
# API key/base URL, and prefills any parameter field on any method whose
# name matches one of the common IDs below (dataset_id, dataflow_id,
# provider_id, ...), still editable per-call in the UI.

# API key generated in Reportnet under Dataflow Settings -> Generate new API key,
# or a "Bearer <jwt>" value. tools/streamlit_app.py auto-detects the
# Authorization header scheme from this value's prefix: "Bearer " -> Bearer
# auth (prefix stripped before use); anything else -> ApiKey auth. For
# scripts/smoke_test.py, pass the scheme explicitly via --token-scheme
# instead (default: ApiKey; use Bearer for a JWT).
REPORTNET_API_KEY=
# Scheme of that value, read by reportnet_api.easy.connect(): ApiKey or Bearer.
# A Bearer token is a bare UUID like an API key, so set this when it is a Bearer.
# REPORTNET_TOKEN_SCHEME=ApiKey

# Override only if testing against a non-production Reportnet instance.
# REPORTNET_BASE_URL=https://api.reportnet.europa.eu

# --- Common IDs ---
# These reappear across most endpoints (a recurring set of parameter names).
# Fill in whichever you have real values for; leave the rest blank.

# Dataflow the key is scoped to.
REPORTNET_DATAFLOW_ID=

# A dataset under that dataflow to run read-only checks against.
REPORTNET_DATASET_ID=

REPORTNET_PROVIDER_ID=
REPORTNET_TABLE_SCHEMA_ID=
REPORTNET_DATASET_SCHEMA_ID=
REPORTNET_JOB_ID=
REPORTNET_FIELD_ID=
REPORTNET_RECORD_ID=
REPORTNET_INTEGRATION_ID=

# Sandbox dataflows live tests may touch (comma-separated); checked by scripts/live_guard.py
# REPORTNET_ALLOWED_DATAFLOW_IDS=

# ApiKey of a reporter/lead reporter for one data provider (Dataflow Settings); used for provider-scoped tests
REPORTNET_PROVIDER_API_KEY=
